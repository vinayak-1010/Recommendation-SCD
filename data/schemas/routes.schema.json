{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Routes",
  "type": "object",
  "required": ["routes"],
  "properties": {
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "time", "distance"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "time": { "type": "number", "minimum": 0 },
          "distance": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}

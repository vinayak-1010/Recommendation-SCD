{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Traffic",
  "type": "object",
  "required": ["patterns"],
  "properties": {
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "peakHours", "multiplier"],
        "properties": {
          "route": { "type": "string" },
          "peakHours": {
            "type": "array",
            "items": { "type": "number", "minimum": 0, "maximum": 23 }
          },
          "multiplier": { "type": "number", "minimum": 1 }
        }
      }
    }
  }
}

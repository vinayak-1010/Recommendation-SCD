{
  "name": "scd-explore-doon",
  "version": "2.0.0",
  "private": true,
  "description": "Explore Doon × Mussoorie · Recommendation System for AWS Student Community Day 2026",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/build-single.ts",
    "build:single": "vite build && node --experimental-strip-types scripts/build-single.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "node --experimental-strip-types test/engine-golden.ts",
    "test:e2e": "node test/e2e.mjs",
    "test:legacy": "node test/smoke.mjs && node test/properties.mjs && node test/characterization.mjs",
    "data:lint": "node --experimental-strip-types scripts/lint-data.ts",
    "data:validate": "node --experimental-strip-types scripts/validate-data.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "jsdom": "30.1.2",
    "playwright": "^1.64.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4"
  }
}
